# Copy to .env and fill in before `docker compose up`. Never commit .env.
# Generate a signing key with e.g.: openssl rand -base64 48
JWT_SECRET=
# Password for the local Postgres container
POSTGRES_PASSWORD=
# Optional: creates admin@flightbooking.local with this password on first start (dev profile)
SEED_ADMIN_PASSWORD=
# Shared secret for signing payment gateway callbacks (openssl rand -hex 32)
PAYMENT_WEBHOOK_SECRET=
